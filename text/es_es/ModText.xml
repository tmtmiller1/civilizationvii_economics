        <Replace Tag="LOC_ECONOMICS_FISCAL_NO_CARD" Language="es_ES"><Text>No tax card</Text></Replace>
        <Replace Tag="LOC_ECONOMICS_FISCAL_EFFECT" Language="es_ES"><Text>Effect in every settlement</Text></Replace>
