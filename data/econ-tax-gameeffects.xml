<?xml version="1.0" encoding="utf-8"?>
<!--
  Economics: the tax cards' modifiers and the tax slot (DESIGN 4.7). Modifiers carry no age key, so this file loads
  in every age; the cards themselves are in data/econ-tax-cards-<age>.xml and the unlocks in data/econ-tax-cards.sql.
  Loaded only with the Taxes setup option on (economics.modinfo, criteria taxes-on-*).

  Each card adds a flat amount to every settlement's Gold and Happiness, in the shape of the base game's Priesthood
  (PRIESTHOOD_MOD_CITY_TOWN_GOLD: EFFECT_CITY_ADJUST_YIELD on COLLECTION_PLAYER_CITIES, YieldType and Amount). The
  AI's card pass rates a card by these face values and took the flat cards where it passed over percentages (P17
  arms, DESIGN 10). The Tooltip argument is what the yield breakdown names. War Levy has two pairs: a small one
  that always pays, and a larger one that holds only while the owner has a formal war (REQUIREMENT_PLAYER_HAS_X_WARS,
  the closest the requirement table comes to "at war with a major civ"). The AI's card pass scores the card as if the
  requirement held (P17 arm 5) and slots it in peace too, so the peacetime pair gives those turns a return; the
  breakdown names both parts "War Levy" (Light arms, 2026-10-30). Light's Happiness differs by age (+6, +4, +3), so it
  has one modifier per age, MOD_ECONOMICS_LIGHT_HAPPINESS_AQ, _EX and _MO, and each age's Light card carries its own.

  The tax slot is one extra policy slot, granted by each age's root civic through ProgressionTreeNodeUnlocks
  (data/econ-tax-cards.sql), in the shape of the base MOD_TOT_TRADITION_SLOT. It is never attached to a card: a card
  that grants the slot it sits in crashed the AI turn (engine-closed.md, 2026-10-17).
-->
<GameEffects xmlns="GameEffects">
    <!-- Light Taxation: Gold -1 in each settlement in every age; its Happiness differs by age, one modifier each -->
    <Modifier id="MOD_ECONOMICS_LIGHT_GOLD" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">-1</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_LIGHT_NAME</Argument>
    </Modifier>
    <!-- Light Taxation in Antiquity: Happiness +6 in each settlement -->
    <Modifier id="MOD_ECONOMICS_LIGHT_HAPPINESS_AQ" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">6</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_LIGHT_NAME</Argument>
    </Modifier>
    <!-- Light Taxation in Exploration: Happiness +4 in each settlement -->
    <Modifier id="MOD_ECONOMICS_LIGHT_HAPPINESS_EX" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">4</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_LIGHT_NAME</Argument>
    </Modifier>
    <!-- Light Taxation in Modern: Happiness +3 in each settlement -->
    <Modifier id="MOD_ECONOMICS_LIGHT_HAPPINESS_MO" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">3</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_LIGHT_NAME</Argument>
    </Modifier>
    <!-- Heavy Taxation: Gold +4, Happiness -2 in each settlement -->
    <Modifier id="MOD_ECONOMICS_HEAVY_GOLD" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">4</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_HEAVY_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_ECONOMICS_HEAVY_HAPPINESS" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">-2</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_HEAVY_NAME</Argument>
    </Modifier>
    <!-- War Levy: Gold +2, Happiness -1 in each settlement -->
    <Modifier id="MOD_ECONOMICS_WAR_LEVY_GOLD" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">2</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_WAR_LEVY_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_ECONOMICS_WAR_LEVY_HAPPINESS" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">-1</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_WAR_LEVY_NAME</Argument>
    </Modifier>
    <!-- War Levy at war: while the owner has a formal war, Gold +6, Happiness -3 more in each settlement -->
    <Modifier id="MOD_ECONOMICS_WAR_LEVY_AT_WAR_GOLD" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <OwnerRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_X_WARS">
                <Argument name="WarType">FORMAL_WAR</Argument>
                <Argument name="Amount">1</Argument>
            </Requirement>
        </OwnerRequirements>
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">6</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_WAR_LEVY_NAME</Argument>
    </Modifier>
    <Modifier id="MOD_ECONOMICS_WAR_LEVY_AT_WAR_HAPPINESS" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <OwnerRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_X_WARS">
                <Argument name="WarType">FORMAL_WAR</Argument>
                <Argument name="Amount">1</Argument>
            </Requirement>
        </OwnerRequirements>
        <Argument name="YieldType">YIELD_HAPPINESS</Argument>
        <Argument name="Amount">-3</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_CARD_WAR_LEVY_NAME</Argument>
    </Modifier>

    <!-- The tax slot, unlocked by a civic (never by a card). -->
    <Modifier id="MOD_ECONOMICS_TAX_SLOT" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_GRANT_TRADITION_SLOTS">
        <Argument name="Amount">1</Argument>
        <Argument name="SlotType">POLICY_CULTURE_SLOT</Argument>
        <String context="Description">LOC_ECONOMICS_TAX_SLOT_DESCRIPTION</String>
    </Modifier>
</GameEffects>
