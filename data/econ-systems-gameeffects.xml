<?xml version="1.0" encoding="utf-8"?>
<!--
  Economics: the economic systems' tax lines (DESIGN 4.17) as level 1 data. Each modifier adds a flat amount to every
  settlement's Gold or Happiness while its government holds and its tax card is slotted, in the shape of the tax
  cards themselves (data/econ-tax-gameeffects.xml): EFFECT_CITY_ADJUST_YIELD on COLLECTION_PLAYER_CITIES, the
  government as a subject requirement as the base governments' own passives have it, the card
  (REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION) and any war or peace as owner requirements. The game applies them to every
  civilization alike and shows them on the yield breakdown under the system's name. The AI's card pass rates a card
  by its own face value and doesn't price these (P17), so they change what a card pays, not which card an AI picks.
  data/econ-systems.sql attaches them through Governments, Traditions and Modifiers; modifiers carry no age, so this
  file loads in every age. Loaded only with Economic systems and Taxes both on.
-->
<GameEffects xmlns="GameEffects">
    <!-- Tribute (Despotism): Heavy Taxation +1 Gold and War Levy +2 Gold and +1 Happiness at war, in each settlement -->
    <Modifier id="MOD_ECONOMICS_SYS_DESPOTISM_HEAVY_GOLD" collection="COLLECTION_PLAYER_CITIES" effect="EFFECT_CITY_ADJUST_YIELD">
        <SubjectRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_GOVERNMENT">
                <Argument name="GovernmentType">GOVERNMENT_DESPOTISM</Argument>
            </Requirement>
        </SubjectRequirements>
        <OwnerRequirements>
            <Requirement type="REQUIREMENT_PLAYER_HAS_ACTIVE_TRADITION">
                <Argument name="TraditionType">TRADITION_ECONOMICS_HEAVY_AQ</Argument>
            </Requirement>
        </OwnerRequirements>
        <Argument name="YieldType">YIELD_GOLD</Argument>
        <Argument name="Amount">1</Argument>
        <Argument name="Tooltip">LOC_ECONOMICS_SYSTEM_TRIBUTE</Argument>
    </Modifier>
